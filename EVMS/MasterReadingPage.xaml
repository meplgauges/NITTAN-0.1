<UserControl x:Class="EVMS.MasterReadingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EVMS"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Design.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT PANEL -->
            <Border Grid.Column="0" Margin="18,18,8,18"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="14">
                <Border.Background>
                    <ImageBrush ImageSource="/Resource/bg3.jpg"
                            Stretch="UniformToFill"
                            Opacity="0.9"/>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="⚙ Master Setup"
                           HorizontalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,15,0,10"
                           VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <!-- ComboBox added above the Parameter label -->
                        <TextBlock Text="Select Part No:" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox  x:Name="cmbPartNo"
                              Style="{StaticResource ModernComboBoxStyle}"
                              HorizontalAlignment="Stretch" />

                        <!-- Using the reusable label style -->
                    <TextBlock Text="Select Parameter:" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="cmbParameter"
                          Style="{StaticResource ModernComboBoxStyle}"
                          HorizontalAlignment="Stretch" />  
                        <TextBlock Text="Nominal:" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="txtNominal" Style="{StaticResource ModernFilledTextBox}"/>
                        <TextBlock Text="R_Tol(+):" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="txtRTolPlus" Style="{StaticResource ModernFilledTextBox}"/>
                        <TextBlock Text="R_Tol(-):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtRTolMinus" Style="{StaticResource ModernFilledTextBox}"/>
                </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"  >
                        <Button x:Name="btnAdd" Content="Add" Width="90" Height="36" Background="#2ECC71" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                        <Button x:Name="btnUpdate" Content="Update" Width="90" Height="36" Background="#F39C12" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                        <Button x:Name="btnDelete" Content="Delete" Width="90" Height="36" Background="#E74C3C" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- RIGHT PANEL -->
            <Border Grid.Column="1" Margin="12,20,20,20"
                BorderBrush="#D9D9D9"
                BorderThickness="0.90"
                CornerRadius="14">
                <!-- Background image -->
                <Border.Background>
                    <ImageBrush ImageSource="/Resource/bg3.jpg"
                            Stretch="UniformToFill"
                            Opacity="1"/>
                </Border.Background>
                <!-- DataGrid -->
            <DataGrid x:Name="dataGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        Margin="10"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        HeadersVisibility="Column"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        AlternatingRowBackground="#F4F6F8"
                        GridLinesVisibility="None"
                        RowHeaderWidth="0"
                        FontSize="14"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="4"
                        RowHeight="38"
                        EnableRowVirtualization="True"
                        ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                        RowStyle="{StaticResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                        <DataGridTextColumn Header="Sr No" Binding="{Binding RowNo}" IsReadOnly="True"  Width="60" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="2*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                        <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                        <DataGridTextColumn Header="R_Tol(+)" Binding="{Binding RTolPlus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="R_Tol(-)" Binding="{Binding RTolMinus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </UserControl>


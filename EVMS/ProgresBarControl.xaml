<UserControl x:Class="EVMS.ProgresBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             Background="Transparent"
             Width="200"
             Height="170"
             MinWidth="130" MinHeight="185"
             x:Name="root">
    <!-- Everything scales proportionally -->
    <Viewbox Stretch="Uniform">
        <Border CornerRadius="20" BorderBrush="Aqua" BorderThickness="1" Padding="15" Background="Black">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Border Width="20" Height="150" CornerRadius="5" Background="#2C2C2C" BorderThickness="0">
                        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100"
                                     Value="{Binding Value, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Orientation="Vertical"
                                     Background="Transparent" BorderThickness="0">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                    <GradientStop Color="#2196F3" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </Border>
                    <Canvas Margin="0,0,0,-6">
                        <Line X1="0" X2="30" Y1="150" Y2="150" Stroke="#888" StrokeThickness="1" StrokeDashArray="4,2"/>
                        <TextBlock Foreground="#F5F6FA" FontSize="10" Canvas.Right="59" Canvas.Top="135"
                           Text="{Binding Min, ElementName=root, StringFormat={}{0:F3}}"/>

                        <Line X1="0" X2="30" Y1="75" Y2="75" Stroke="#888" StrokeThickness="1" StrokeDashArray="4,2"/>
                        <TextBlock Foreground="#F5F6FA" FontSize="10" Canvas.Right="59" Canvas.Top="77"
                           Text="{Binding Mean, ElementName=root, StringFormat={}{0:F3}}"/>

                        <Line X1="0" X2="32" Y1="0" Y2="0" Stroke="#888" StrokeThickness="1" StrokeDashArray="4,2"/>
                        <TextBlock Foreground="#F5F6FA" FontSize="10" Canvas.Right="59" Canvas.Top="0"
                           Text="{Binding Max, ElementName=root, StringFormat={}{0:F3}}"/>
                    </Canvas>

                </Grid>
                <TextBlock x:Name="BarValue"
                           Text="{Binding Value, ElementName=root, StringFormat={}{0:F1}}"
                           HorizontalAlignment="Center"
                           Foreground="#F5F6FA"
                           FontSize="15"
                           FontWeight="Bold"/>
                <TextBlock x:Name="TitleBox"
                         Height="25" Width="80"
                         Foreground="#F5F6FA"
                         Padding="2"
                         FontSize="11"
                         Text="{Binding Title, ElementName=root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Viewbox>
</UserControl>

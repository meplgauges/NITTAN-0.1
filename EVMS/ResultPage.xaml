<UserControl x:Class="EVMS.ResultPage"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EVMS"
             Background="White"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#777" BlurRadius="12" ShadowDepth="1" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
        </Style>
        <!-- Label style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <!-- Visuals -->
            <Setter Property="Foreground" Value="#283445"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- Responsive behavior -->
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- auto-wrap long text -->
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <!-- "..." if no space -->
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Heading style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#234E70"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!-- DataGrid for modern look -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/>
        </Style>

        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <!-- Remove fixed Width/Height -->
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxWidth" Value="200"/>
            <!-- prevent too wide on large screen -->
            <!-- Stretch to fill available space -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Visuals -->
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#234E70"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <!-- reduced a bit to fit smaller screens -->
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Top info panel -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Left and Right panels -->
            <RowDefinition Height="270"/>
            <!-- Row 2: DataGrid -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Left panel -->
            <ColumnDefinition Width="2.8*"/>
            <!-- Right panel -->
        </Grid.ColumnDefinitions>

        <!-- Row 0: Top Info Panel spanning both columns -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Part No -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="8,0">
                <TextBlock Text="Part No" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox Style="{StaticResource ValueBoxStyle}" Text="34"/>
            </StackPanel>

            <!-- Lot No -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0">
                <TextBlock Text="Lot No" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox Style="{StaticResource ValueBoxStyle}"/>
            </StackPanel>

            <!-- Operator ID -->
            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="8,0">
                <TextBlock Text="Operator ID" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox Style="{StaticResource ValueBoxStyle}"/>
            </StackPanel>

            <!-- Inspection Qty -->
            <StackPanel Grid.Column="3" Orientation="Vertical" Margin="8,0">
                <TextBlock Text="Inspection Qty" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox Style="{StaticResource ValueBoxStyle}"/>
            </StackPanel>

            <!-- OK Count -->
            <StackPanel Grid.Column="4" Orientation="Vertical" Margin="8,0">
                <TextBlock Text="OK Count" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox Style="{StaticResource ValueBoxStyle}" Foreground="#44BA6B" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- NG Count -->
            <StackPanel Grid.Column="5" Orientation="Vertical" Margin="8,0">
                <TextBlock Text="NG Count" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox Style="{StaticResource ValueBoxStyle}" Foreground="#EA5455" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- Row 1 Left Panel: Valve Image and Dimensions -->
        <Viewbox Grid.Row="1" Grid.Column="0" Stretch="Uniform" >
            <Canvas Width="820" Height="400" Background="#F7FAFC">

                <!-- Valve Image -->
                <Image Source="/Resource/valve.png"
               Width="700" Height="400"
               Canvas.Left="43" Canvas.Top="-22"/>

                <!-- Groove Dia -->
                <Line X1="90" Y1="162" X2="90" Y2="198" Stroke="#5090F9" StrokeDashArray="4 2" StrokeThickness="2"/>
                <Line X1="89" Y1="162" X2="110" Y2="162" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="89" Y1="196" X2="110" Y2="196" Stroke="#5090F9" StrokeThickness="2"/>
                <TextBlock Text="GROOVE DIA" Style="{StaticResource LabelStyle}" Canvas.Left="10" Canvas.Top="170"/>
                <TextBox x:Name="GrooveDiaBox" Text="--" 
                Style="{StaticResource ValueBoxStyle}" 
                    Canvas.Left="15" Canvas.Top="191"/>
                <!-- Stem Dia -->
                <Line X1="400" Y1="130" X2="400" Y2="165" Stroke="#5090F9" StrokeThickness="2"/>
                <TextBlock Text="STEM DIA" Style="{StaticResource LabelStyle}" Canvas.Left="410" Canvas.Top="120"/>
                <TextBox x:Name="StemDiaBox" Text="--" 
                Style="{StaticResource ValueBoxStyle}" 
                Canvas.Left="480" Canvas.Top="121"/>

                <!-- Head Dia -->
                <Line X1="665" Y1="250" X2="720" Y2="250" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="720" Y1="100" X2="720" Y2="250" Stroke="#5090F9" StrokeDashArray="4 2" StrokeThickness="2"/>
                <TextBlock Text="HEAD DIA" Style="{StaticResource LabelStyle}" Canvas.Left="730" Canvas.Top="160"/>
                <TextBox x:Name="HeadDiaBox" Text="--" 
                 Style="{StaticResource ValueBoxStyle}" 
                 Canvas.Left="725" Canvas.Top="180"/>


                <!-- Seat Height -->
                <Line X1="700" Y1="70" X2="665" Y2="70" Stroke="#5090F9" StrokeDashArray="4 2" StrokeThickness="2"/>
                <Line X1="663" Y1="98" X2="663" Y2="70" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="665" Y1="100" X2="720" Y2="100" Stroke="#5090F9" StrokeThickness="2"/>
                <TextBlock Text="SEAT HEIGHT" Style="{StaticResource LabelStyle}" Canvas.Left="640" Canvas.Top="40"/>
                <TextBox x:Name="SeatHeightBox" Text="--" 
               Style="{StaticResource ValueBoxStyle}" 
                 Canvas.Left="715" Canvas.Top="35"/>


                <!-- Datum to End -->
                <Line X1="648" Y1="270" X2="648" Y2="240" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="645" Y1="120" X2="645" Y2="70" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="110" Y1="70" X2="110" Y2="161" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="110" Y1="70" X2="645" Y2="70" Stroke="#5090F9" StrokeDashArray="4 2" StrokeThickness="2"/>
                <TextBlock Text="DATUM TO END" Style="{StaticResource LabelStyle}" Canvas.Left="350" Canvas.Top="50"/>
                <TextBox x:Name="DatumToEndBox" Text="3434" 
         Style="{StaticResource ValueBoxStyle}" 
         Canvas.Left="460" Canvas.Top="38"/>

                <!-- Datum to Groove -->
                <Line X1="665" Y1="320" X2="665" Y2="250" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="140" Y1="270" X2="140" Y2="195" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="140" Y1="270" X2="650" Y2="270" Stroke="#5090F9" StrokeDashArray="4 2" StrokeThickness="2"/>
                <TextBlock Text="DATUM TO GROOVE" Style="{StaticResource LabelStyle}" Canvas.Left="340" Canvas.Top="280"/>
                <TextBox x:Name="DatumToGrooveBox" Text="--" 
         Style="{StaticResource ValueBoxStyle}" 
         Canvas.Left="470" Canvas.Top="281"/>


                <!-- Overall Length -->
                <Line X1="110" Y1="320" X2="110" Y2="195" Stroke="#5090F9" StrokeThickness="2"/>
                <Line X1="110" Y1="320" X2="665" Y2="320" Stroke="#5090F9" StrokeDashArray="4 2" StrokeThickness="2"/>
                <TextBlock Text="OVERALL LENGTH" Style="{StaticResource LabelStyle}" Canvas.Left="340" Canvas.Top="330"/>
                <TextBox x:Name="OverallLengthBox" Text="--" 
         Style="{StaticResource ValueBoxStyle}" 
         Canvas.Left="470" Canvas.Top="331"/>
            </Canvas>
        </Viewbox>

        <!-- Row 1 Right Panel: Empty or Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <!-- Button to switch progress bar design -->
            <ToggleButton x:Name="SwitchProgressBarBtn"
                  Width="80"
                  Height="36"
                  Margin="10"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Checked="SwitchProgressBar_Click"
                  Unchecked="SwitchProgressBar_Click">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SwitchTrack"
                            Background="#2196F3"
                            CornerRadius="18"
                            Height="36"
                            Width="80"/>
                            <Ellipse x:Name="SwitchThumb"
                             Width="30"
                             Height="30"
                             Fill="#F2F5F6"
                             Margin="3"
                             HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation
                                        Storyboard.TargetName="SwitchThumb"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                        To="0" Duration="0:0:0.1"/>
                                            <ColorAnimation
                                        Storyboard.TargetName="SwitchTrack"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#2196F3" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation
                                        Storyboard.TargetName="SwitchThumb"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                        To="44" Duration="0:0:0.1"/>
                                            <ColorAnimation
                                        Storyboard.TargetName="SwitchTrack"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#4CAF50" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <!-- UniformGrid for perfectly aligned rows/columns -->
            <UniformGrid x:Name="ProgressBarContainer"
                 Columns="5"         
                HorizontalAlignment="Center"
                 VerticalAlignment="Top">
                <!-- Example: add your gauge controls here, no margin -->
                <!-- <local:ResultProgressBar /> -->
                <!-- ... -->
            </UniformGrid>
        </StackPanel>






        <!-- Row 2: DataGrid spanning both columns -->
        <Border Style="{StaticResource CardBox}"
        Grid.Row="2" Grid.ColumnSpan="2"
        Margin="20,5,20,10" Padding="3">

            <DataGrid x:Name="ValveReadingsGrid"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      Background="#1E1E1E"
                      Foreground="White"
                      BorderBrush="#333"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#2A2A2A"
                      HorizontalGridLinesBrush="#444"
                      VerticalGridLinesBrush="#444"
                      RowHeight="20"
                      ColumnHeaderHeight="30"
                      FontSize="14"
                      FontFamily="Segoe UI">

                <!-- Modern Styles -->
                <DataGrid.Resources>
                    <!-- Header Style -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#444"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6"/>
                    </Style>

                    <!-- Row Style -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Margin" Value="0,1,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Cell Style (applies to all text cells) -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <!-- Columns -->
                <DataGrid.Columns>
                    <!-- Serial Number Column -->
                    <DataGridTextColumn Header="S.No." Binding="{Binding SerialNumber}" Width="50" IsReadOnly="True" />

                    <DataGridTextColumn Header="Groove Dia" Binding="{Binding GrooveDia}" Width="*" />
                    <DataGridTextColumn Header="STNG" Binding="{Binding STNG}" Width="*" />
                    <DataGridTextColumn Header="STNU" Binding="{Binding STNU}" Width="*" />
                    <DataGridTextColumn Header="Groove Position" Binding="{Binding GroovePositon}" Width="*" />
                    <DataGridTextColumn Header="Seat Ro" Binding="{Binding SeatRo}" Width="*" />
                    <DataGridTextColumn Header="Head Dia" Binding="{Binding HeadDia}" Width="*" />
                    <DataGridTextColumn Header="Seat Height" Binding="{Binding SeatHeight}" Width="*" />
                    <DataGridTextColumn Header="Datum To End" Binding="{Binding DatumToEnd}" Width="*" />
                    <DataGridTextColumn Header="Datum To Groove" Binding="{Binding DatuToGroove}" Width="*" />
                    <DataGridTextColumn Header="Overall Length" Binding="{Binding OverLeght}" Width="*" />
                </DataGrid.Columns>

            </DataGrid>
        </Border>

    </Grid>
</UserControl>
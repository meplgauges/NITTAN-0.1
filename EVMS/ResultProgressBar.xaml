<UserControl x:Class="EVMS.ResultProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="250" MinHeight="120"
             Background="Transparent">

    <Viewbox Stretch="Uniform">
        <!-- Canvas logical size; Viewbox will scale it -->
        <Canvas x:Name="GaugeCanvas" Width="330" Height="250">

            <!-- Backing layers (drawn in code) -->
            <Canvas x:Name="ArcsLayer" IsHitTestVisible="False"/>
            <Canvas x:Name="TicksLayer" IsHitTestVisible="False"/>

            <!-- Needle (will be positioned in code) -->
            <Line x:Name="Needle"
                  Stroke="Red"
                  StrokeThickness="5"
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  IsHitTestVisible="False">
                <Line.RenderTransform>
                    <RotateTransform x:Name="NeedleRotate" Angle="0"/>
                </Line.RenderTransform>
            </Line>

            <!-- Hub container (circle + value inside) -->
            <Grid x:Name="HubContainer"
                  Width="40" Height="40"
                  IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
                <Ellipse Fill="Black"/>
                <TextBlock x:Name="CenterValueText"
                           Text="0.000"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Bottom label -->
            <TextBlock x:Name="LabelID"
                       Text="ID"
                       FontSize="12"
                       FontWeight="Bold"
                       IsHitTestVisible="False"/>

        </Canvas>
    </Viewbox>
</UserControl>

<UserControl x:Class="EVMS.ResultProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EVMS"
             mc:Ignorable="d" 
             MinWidth="80" MinHeight="80">
    <Viewbox Stretch="Uniform">
        <Grid Width="140" Height="140">
            <!-- Circle and Arc -->
            <Ellipse Stroke="#E5E9F2" StrokeThickness="12"/>
            <Path x:Name="ValueArc" Stroke="#4A90E2" StrokeThickness="12"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  SnapsToDevicePixels="True">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="20,70">
                            <ArcSegment Size="50,50"
                                        SweepDirection="Clockwise" 
                                        IsLargeArc="False" 
                                        Point="120,70"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- Top Center Value -->
            <TextBlock Text="0.40" Foreground="Black" FontWeight="Bold"
                       FontSize="8"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,26,0,0"/>

            <!-- Left Value (Start of Arc) -->
            <TextBlock Text="4.03" Foreground="Black" FontWeight="Bold"
                       FontSize="8"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="22,0,0,53"/>

            <!-- Right Value (End of Arc) -->
            <TextBlock x:Name="mid" Text="4.04" Foreground="Black" FontWeight="Bold"
                       FontSize="8"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,22,53"/>

            <!-- Center Value Box -->
            <Border Background="#1E1E1E" CornerRadius="8"
                    Padding="8,4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ValueText"
                           Text="0.00"
                           Foreground="White"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Bottom Label -->
            <Border Background="#F4F6F9"
                    CornerRadius="6"
                    Padding="12,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20">
                <TextBlock x:Name="LabelText"
                           Text="Label"
                           Foreground="#333"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>

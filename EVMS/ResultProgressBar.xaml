<UserControl x:Class="EVMS.ResultProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EVMS"
             mc:Ignorable="d" 
             MinWidth="80" MinHeight="80">

    <!-- Viewbox keeps it responsive -->
    <Viewbox Stretch="Uniform">
        <Grid Width="140" Height="140">

            <!-- Inner Background Circle (light gray track) -->
            <Ellipse Stroke="#E5E9F2" StrokeThickness="12"/>

            <!-- Progress Arc -->
            <Path x:Name="ValueArc" Stroke="#4A90E2" StrokeThickness="12"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  SnapsToDevicePixels="True">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure x:Name="ArcStart" StartPoint="20,70">
                            <ArcSegment x:Name="ArcSegment" Size="50,50"
                                        SweepDirection="Clockwise" 
                                        IsLargeArc="False" 
                                        Point="120,70"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- Center Value Box -->
            <Border Background="#1E1E1E" CornerRadius="8"
                    Padding="8,4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    >
                <TextBlock x:Name="ValueText"
                           Text="0.00"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Bottom Label -->
            <Border Background="#F4F6F9"
                    CornerRadius="6"
                    Padding="12,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20">
                <TextBlock x:Name="LabelText"
                           Text="Label"
                           Foreground="#333"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Viewbox>
</UserControl>

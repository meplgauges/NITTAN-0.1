<UserControl x:Class="EVMS.Part_Manager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Design.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- TITLE BAR -->
      
        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg" Stretch="UniformToFill"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- INPUT PANEL -->
                <Border Padding="20"
                        CornerRadius="16"
                        Width="990"
                        Height="150"
                        Background="#AAFFFFFF"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="12"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <!-- Part Number -->
                        <StackPanel Width="300" Margin="1,0">
                            <TextBlock Text="Part Number" FontWeight="SemiBold" Margin="1" />
                            <TextBox x:Name="txtPartNumber"
                                     Height="38"
                                     Padding="8"
                                     BorderThickness="1"
                                     BorderBrush="#CCCCCC"
                                     Background="#F9F9F9"
                                     Style="{StaticResource ModernFilledTextBox1}"/>
                        </StackPanel>
                        <!-- Part Name -->
                        <StackPanel Width="300" Margin="1,0">
                            <TextBlock Text="Part Name" FontWeight="SemiBold" Margin="2"/>
                            <TextBox x:Name="txtPartName"
                                     Height="38"
                                    
                                     Padding="8"
                                     BorderThickness="1"
                                     BorderBrush="#CCCCCC"
                                     Background="#F9F9F9"
                                     Style="{StaticResource ModernFilledTextBox1}"/>
                        </StackPanel>
                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0">
                            <Button Content="Add" x:Name="btnAdd" Style="{StaticResource AddButtonStyle}" Click="BtnAdd_Click"/>
                            <Button Content="Update" x:Name="btnUpdate" Style="{StaticResource UpdateButtonStyle}"/>
                            <Button Content="Delete" x:Name="btnDelete" Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Spacer for Gap -->
                <Border Height="24" Background="Transparent"/>

                <!-- DATA GRID PANEL -->
                <Border Padding="15"
                        CornerRadius="16"
                        Width="980"
                        Height="220"
                        Background="#CCFFFFFF"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>
                    <DataGrid x:Name="dataGrid"
                              AutoGenerateColumns="False"
                              SelectionChanged="dataGrid_SelectionChanged"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              RowBackground="White"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              BorderThickness="0"
                              FontSize="20"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Part Number" Binding="{Binding Para_No}" Width="*"/>
                            <DataGridTextColumn Header="Part Name" Binding="{Binding Para_Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

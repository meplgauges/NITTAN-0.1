<UserControl x:Class="EVMS.Part_Manager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="950">

    <!-- Button Styles -->
    <UserControl.Resources>
        <Style x:Key="ModernFilledTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F0F3FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#80A0B9C9"/>
            <!-- Semi-transparent border -->
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="20,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#804A90E2" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Add Button Style -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Update Button Style -->
        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource AddButtonStyle}">
            <Setter Property="Background" Value="#2196F3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Delete Button Style -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource AddButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="White" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- TITLE BAR -->
      
        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg" Stretch="UniformToFill"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- INPUT PANEL -->
                <Border Padding="20"
                        CornerRadius="16"
                        Width="990"
                        Height="150"
                        Background="#AAFFFFFF"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="12"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <!-- Part Number -->
                        <StackPanel Width="300" Margin="1,0">
                            <TextBlock Text="Part Number" FontWeight="SemiBold" Margin="1" />
                            <TextBox x:Name="txtPartNumber"
                                     Height="38"
                                     Padding="8"
                                     BorderThickness="1"
                                     BorderBrush="#CCCCCC"
                                     Background="#F9F9F9"
                                     Style="{StaticResource ModernFilledTextBox}"/>
                        </StackPanel>
                        <!-- Part Name -->
                        <StackPanel Width="300" Margin="1,0">
                            <TextBlock Text="Part Name" FontWeight="SemiBold" Margin="2"/>
                            <TextBox x:Name="txtPartName"
                                     Height="38"
                                    
                                     Padding="8"
                                     BorderThickness="1"
                                     BorderBrush="#CCCCCC"
                                     Background="#F9F9F9"
                                     Style="{StaticResource ModernFilledTextBox}"/>
                        </StackPanel>
                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0">
                            <Button Content="Add" x:Name="btnAdd" Style="{StaticResource AddButtonStyle}" Click="BtnAdd_Click"/>
                            <Button Content="Update" x:Name="btnUpdate" Style="{StaticResource UpdateButtonStyle}"/>
                            <Button Content="Delete" x:Name="btnDelete" Style="{StaticResource DeleteButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Spacer for Gap -->
                <Border Height="24" Background="Transparent"/>

                <!-- DATA GRID PANEL -->
                <Border Padding="15"
                        CornerRadius="16"
                        Width="980"
                        Height="220"
                        Background="#CCFFFFFF"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>
                    <DataGrid x:Name="dataGrid"
                              AutoGenerateColumns="False"
                              SelectionChanged="dataGrid_SelectionChanged"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              RowBackground="White"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              BorderThickness="0"
                              FontSize="20"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Part Number" Binding="{Binding Para_No}" Width="*"/>
                            <DataGridTextColumn Header="Part Name" Binding="{Binding Para_Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

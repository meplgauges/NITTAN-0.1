<UserControl x:Class="EVMS.PartConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Black">
    <UserControl.Resources>
        <!-- Reusable Label Style to avoid repeating TextBlock settings -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="20,10,0,4"/>
        </Style>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="8" ShadowDepth="2" Direction="270" Color="#33000000"/>
        <!-- Modern Filled TextBox -->
        <Style x:Key="ModernFilledTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F0F3FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#80A0B9C9"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="20,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#804A90E2" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Pill Style CheckBox -->
        <Style x:Key="PillCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="OuterBorder"
                        Background="#F9FAFB"
                        CornerRadius="20"
                        Padding="12,8"
                        SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                                <Grid Width="24" Height="24" Margin="0,0,10,0">
                                    <Ellipse x:Name="Circle"
                                     Fill="#E5E7EB"
                                     StrokeThickness="0"/>
                                    <Path x:Name="CheckMark"
                                  Data="M4,12 L9,17 L20,6"
                                  Stroke="White"
                                  StrokeThickness="2.5"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#2ECC71"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Optional: DropShadow Effect for Left Panel -->
        <DropShadowEffect x:Key="DropShadowEffectLight" BlurRadius="8" ShadowDepth="1" Direction="270" Color="#24000000"/>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="20,6"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Background" Value="#F0F3FA"/>
            <Setter Property="BorderBrush" Value="#80A0B9C9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Focusable="false"
                                                  IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Right"
                                                  Width="30" />
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="6,3,30,3"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="200"
                                      Background="White"
                                      >
                                    <ScrollViewer Margin="4,6,4,6"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#EEE"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A90E2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2ECC71"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Margin="18,18,8,18"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg"
                            Stretch="UniformToFill"
                            Opacity="0.9"/>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="⚙ Part Configuration"
                           HorizontalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,15,0,10"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <!-- ComboBox added above the Parameter label -->
                    <TextBlock Text="Select Part No:" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="cmbPartNo"
                              Style="{StaticResource ModernComboBoxStyle}"
                              HorizontalAlignment="Stretch" />

                    <!-- Using the reusable label style -->
                    <TextBlock Text="Parameter:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtParameter" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="Nominal:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtNominal" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="R_Tol(+):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtRTolPlus" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="R_Tol(-):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtRTolMinus" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="Y_Tol(+):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtYTolPlus" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="Y_Tol(-):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtYTolMinus" Style="{StaticResource ModernFilledTextBox}"/>
                    <CheckBox x:Name="chkProbe"
                              Content="This is Probe ?"
                              Style="{StaticResource PillCheckBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"  >
                    <Button x:Name="btnAdd" Content="Add" Width="90" Height="36" Background="#2ECC71" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                    <Button x:Name="btnUpdate" Content="Update" Width="90" Height="36" Background="#F39C12" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                    <Button x:Name="btnDelete" Content="Delete" Width="90" Height="36" Background="#E74C3C" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

              

            </Grid>
        </Border>
        <!-- RIGHT PANEL -->
        <Border Grid.Column="1" Margin="12,20,20,20"
                BorderBrush="#D9D9D9"
                BorderThickness="0.90"
                CornerRadius="14">
            <!-- Background image -->
            <Border.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg"
                            Stretch="UniformToFill"
                            Opacity="1"/>
            </Border.Background>
            <!-- DataGrid -->
            <DataGrid x:Name="dataGrid"
                      AutoGenerateColumns="False"
                      SelectionChanged="dataGrid_SelectionChanged"
                      LoadingRow="dataGrid_LoadingRow"
                      IsReadOnly="True"
                      Margin="10"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False" 
                      CanUserResizeRows="False"
                      AlternatingRowBackground="#F4F6F8" 
                      GridLinesVisibility="None" 
                      RowHeaderWidth="0"
                      FontSize="14" 
                      Background="Transparent"   
                      BorderBrush="Transparent"
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Padding="4"
                      RowHeight="38"
                      EnableRowVirtualization="True">
                <!-- Column Header Style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D3748"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8 4"/>
                        <Setter Property="Height" Value="38"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <!-- Row Style -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#222"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="6 2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3182CE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <!-- Define cell alignment style -->
                <DataGrid.Resources>
                    <Style x:Key="CenterCellStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <!-- Columns with centered content -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sr No" Binding="{Binding RowNo}" IsReadOnly="True"  Width="60" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="2*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="R_Tol(+)" Binding="{Binding RTolPlus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="R_Tol(-)" Binding="{Binding RTolMinus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="Y_Tol(+)" Binding="{Binding YTolPlus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="Y_Tol(-)" Binding="{Binding YTolMinus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                    <DataGridTextColumn Header="Type" Binding="{Binding ProbeStatus}" Width="*" 
                                ElementStyle="{StaticResource CenterCellStyle}" 
                                EditingElementStyle="{StaticResource CenterCellStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

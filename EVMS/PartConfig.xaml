<UserControl x:Class="EVMS.PartConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Black">

    <UserControl.Resources>
        <!-- Reusable Label Style to avoid repeating TextBlock settings -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="20,10,0,4"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="8" ShadowDepth="2" Direction="270" Color="#33000000"/>

        <!-- Modern Filled TextBox -->
        <Style x:Key="ModernFilledTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="#F0F3FA"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#80A0B9C9"/> <!-- Semi-transparent border -->
    <Setter Property="Foreground" Value="#222"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="20,6"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#804A90E2" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  Margin="0"/>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>


        <!-- Optional: DropShadow Effect for Left Panel -->
        <DropShadowEffect x:Key="DropShadowEffectLight" BlurRadius="8" ShadowDepth="1" Direction="270" Color="#24000000"/>
    </UserControl.Resources>

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Margin="18,18,8,18"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="14"
             >
            <Border.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg"
                    Stretch="UniformToFill"
                    Opacity="0.90"/>
            </Border.Background>
            <Grid>
               
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="⚙ Part Configuration"
                           HorizontalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           Margin="0,15,0,10"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <!-- Using the reusable label style -->
                    <TextBlock Text="Parameter:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtParameter" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="Nominal:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtNominal" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="R_Tol(+):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtRTolPlus" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="R_Tol(-):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtRTolMinus" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="Y_Tol(+):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtYTolPlus" Style="{StaticResource ModernFilledTextBox}"/>
                    <TextBlock Text="Y_Tol(-):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtYTolMinus" Style="{StaticResource ModernFilledTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"  >
                    <Button x:Name="btnAdd" Content="Add" Width="90" Height="36" Background="#2ECC71" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                    <Button x:Name="btnUpdate" Content="Update" Width="90" Height="36" Background="#F39C12" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                    <Button x:Name="btnDelete" Content="Delete" Width="90" Height="36" Background="#E74C3C" Foreground="White" FontWeight="SemiBold" Margin="0,22,12,0" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="12,20,20,20"
        BorderBrush="#D9D9D9"
        BorderThickness="0.90"
        CornerRadius="14"
      >

            <!-- Subtle background image -->
            <Border.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg"
                    Stretch="UniformToFill"
                    Opacity="1"/>
            </Border.Background>

            <!-- DataGrid -->
            <DataGrid x:Name="dgPartConfig" 
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False" 
              CanUserDeleteRows="False" 
              CanUserResizeRows="False"
              AlternatingRowBackground="#F4F6F8" 
              GridLinesVisibility="None" 
              RowHeaderWidth="0"
              Margin="10" 
              FontSize="14" 
              Background="Transparent"   
                BorderBrush="Transparent"
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch"
              Padding="4"
              RowHeight="38"
              EnableRowVirtualization="True" 
              >
                <!-- ✅ Fixed event name -->

                <!-- Column Header Style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2D3748"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8 4"/>
                        <Setter Property="Height" Value="38"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Row Style -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#222"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="6 2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3182CE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Modernized Columns -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sr No" Binding="{Binding SrNo}" Width="60"/>
                    <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="2*"/>
                    <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal}" Width="*"/>
                    <DataGridTextColumn Header="R_Tol(+)" Binding="{Binding RTolPlus}" Width="*"/>
                    <DataGridTextColumn Header="R_Tol(-)" Binding="{Binding RTolMinus}" Width="*"/>
                    <DataGridTextColumn Header="Y_Tol(+)" Binding="{Binding YTolPlus}" Width="*"/>
                    <DataGridTextColumn Header="Y_Tol(-)" Binding="{Binding YTolMinus}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>

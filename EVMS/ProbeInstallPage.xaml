<UserControl x:Class="EVMS.ProbeInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black"
             FontFamily="Segoe UI" FontSize="14">

    <UserControl.Resources>
        <!-- Common Rounded Button Base Style -->
        <Style x:Key="RoundedButtonBase" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray" />
                                <Setter TargetName="border" Property="Background" Value="#333333" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Style for Reset Button (Red) -->
        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonBase}">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="BorderBrush" Value="#B71C1C" />
            <Setter Property="Tag" Value="#B71C1C" />
            <!-- Button pressed background -->
        </Style>

        <!-- Style for Install Button (Blue) -->
        <Style x:Key="InstallButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonBase}">
            <Setter Property="Background" Value="#58A8E8"/>
            <Setter Property="BorderBrush" Value="#2E7BD8"/>
            <Setter Property="Tag" Value="#2E7BD8" />
            <!-- Button pressed background -->
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Border CornerRadius="12" Padding="16">
            <Border.Background>
                <ImageBrush ImageSource="/Resource/bg3.jpg"
                            Stretch="UniformToFill"
                            Opacity="0.90"/>
            </Border.Background>
            <StackPanel>
                <!-- Top area with Grid for left controls and right button -->
                <Grid Margin="0,0,0,20" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Label + ComboBox -->
                        <ColumnDefinition Width="*" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Reset Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Label and ComboBox grouped on left -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Select Part:" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <ComboBox Width="180" Height="32" Padding="4,2"
                                  ItemsSource="{Binding PartNumbers}"
                                  SelectedItem="{Binding SelectedPartNo, Mode=TwoWay}"
                                  Background="#2D2D2D"
                                  Foreground="#2D2D2D"
                                  BorderBrush="#555"
                                  BorderThickness="1"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Spacer auto expands Column 1 -->

                    <!-- Reset button aligned right corner with style -->
                    <Button Grid.Column="2" Content="Reset All Probes"
                            Width="140"
                            VerticalAlignment="Center"
                            Style="{StaticResource ResetButtonStyle}"
                            ToolTip="Reset all probes data"
                            Click="ResetAllProbes_Click" />
                </Grid>

                <!-- Table Header -->
                <Grid Background="#2D2D2D" Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="No." Grid.Column="0" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="Name" Grid.Column="1" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="Probe Name" Grid.Column="2" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="Probe ID" Grid.Column="3" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="Stroke" Grid.Column="4" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="Status" Grid.Column="5" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="Actions" Grid.Column="6" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Dynamic Probe Rows -->
                <ItemsControl ItemsSource="{Binding Probes}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A1A" CornerRadius="4" Margin="0,2" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding No}" Grid.Column="0" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Grid.Column="1" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProbeName}" Grid.Column="2" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProbeId}" Grid.Column="3" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stroke}" Grid.Column="4" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <!-- Status with color -->
                                    <TextBlock Text="{Binding Status}" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                        <Setter Property="Foreground" Value="LightGreen"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="🔧 Install"
                                                Width="90"
                                                Height="30"
                                                Margin="4,0"
                                                Padding="4"
                                                Style="{StaticResource InstallButtonStyle}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Click="CheckButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

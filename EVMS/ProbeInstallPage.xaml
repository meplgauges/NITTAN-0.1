<UserControl x:Class="EVMS.ProbeInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212"
             FontFamily="Segoe UI" FontSize="14">

    <Grid Margin="20">
        <Border CornerRadius="12" Background="#1E1E1E" Padding="16">
            <StackPanel>

                <!-- Model Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                    <TextBlock Text="Select Model:"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"/>

                    <ComboBox x:Name="ModelComboBox"
                              Width="180"
                              Height="32"
                              Padding="4,2"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              Background="#2D2D2D"
                              Foreground="White"
                              BorderBrush="#555"
                              BorderThickness="1"
                              />
                </StackPanel>

                <!-- Table Header -->
                <Grid Background="#2D2D2D" Height="42" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="No." Grid.Column="0" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Name" Grid.Column="1" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Probe Name" Grid.Column="2" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Probe ID" Grid.Column="3" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Stroke" Grid.Column="4" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Status" Grid.Column="5" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Actions" Grid.Column="6" Foreground="#BBBBBB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <!-- Dynamic Probe Rows -->
                <ItemsControl ItemsSource="{Binding Probes}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A1A" CornerRadius="4" Margin="0,2" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding No}" Grid.Column="0" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Grid.Column="1" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProbeName}" Grid.Column="2" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProbeId}" Grid.Column="3" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stroke}" Grid.Column="4" Foreground="White" VerticalAlignment="Center"/>

                                    <!-- Status with color -->
                                    <TextBlock Text="{Binding Status}" Grid.Column="5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                        <Setter Property="Foreground" Value="LightGreen"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✔ Check"
                                                Width="70"
                                                Height="30"
                                                Margin="4,0"
                                                Padding="4"
                                                Background="#2A2A2A"
                                                Foreground="White"
                                                BorderBrush="#555"
                                                BorderThickness="1"
                                                Click="CheckButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="{TemplateBinding Padding}" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🔧 Install"
                                                Width="70"
                                                Height="30"
                                                Margin="4,0"
                                                Padding="4"
                                                Background="#2A2A2A"
                                                Foreground="White"
                                                BorderBrush="#555"
                                                BorderThickness="1"
                                                Click="InstallButton_Click"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>

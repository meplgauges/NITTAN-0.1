<UserControl x:Class="EVMS.ProbeInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">

    <Grid Margin="20">
        <Border CornerRadius="12" Background="#1E1E1E" Padding="12" Margin="16">
            <StackPanel>
                <!-- Model Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                    <TextBlock Text="Select Model:" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModelComboBox"
                              Width="150"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              Background="#2D2D2D"
                              Foreground="White"
                              BorderBrush="#555"/>
                </StackPanel>

                <!-- Table Header -->
                <Grid Background="#2D2D2D" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="80"/>
                        <ColumnDefinition Width="2*" MinWidth="140"/>
                        <ColumnDefinition Width="2*" MinWidth="140"/>
                        <ColumnDefinition Width="2*" MinWidth="140"/>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                        <ColumnDefinition Width="2*" MinWidth="120"/>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="No." Grid.Column="0" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Name" Grid.Column="1" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Probe Name" Grid.Column="2" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Probe ID" Grid.Column="3" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Stroke" Grid.Column="4" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Status" Grid.Column="5" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Actions" Grid.Column="6" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- Dynamic Rows -->
                <ItemsControl ItemsSource="{Binding Probes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="#252525" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                    <ColumnDefinition Width="2*" MinWidth="140"/>
                                    <ColumnDefinition Width="2*" MinWidth="140"/>
                                    <ColumnDefinition Width="2*" MinWidth="140"/>
                                    <ColumnDefinition Width="*" MinWidth="100"/>
                                    <ColumnDefinition Width="2*" MinWidth="120"/>
                                    <ColumnDefinition Width="2*" MinWidth="180"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding No}" Grid.Column="0" Foreground="White"/>
                                <TextBlock Text="{Binding Name}" Grid.Column="1" Foreground="White"/>
                                <TextBlock Text="{Binding ProbeName}" Grid.Column="2" Foreground="White"/>
                                <TextBlock Text="{Binding ProbeId}" Grid.Column="3" Foreground="White"/>
                                <TextBlock Text="{Binding Stroke}" Grid.Column="4" Foreground="White"/>

                                <!-- Status with dynamic color -->
                                <TextBlock Text="{Binding Status}" Grid.Column="5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                    <Setter Property="Foreground" Value="LightGreen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✔ Check" Width="60" Height="28" Margin="2"/>
                                    <Button Content="🔧 Install" Width="60" Height="28" Margin="2"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>

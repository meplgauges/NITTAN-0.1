<UserControl x:Class="EVMS.ProbeSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EVMS"
             Background="Black">

    <UserControl.Resources>
        <!-- Border Style -->
        <Style x:Key="DefaultBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="Background" Value="#222"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Dropdown to Select Part -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Select Part: " Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            <ComboBox x:Name="PartSelector"
                      Width="200"
                      Margin="10,0,0,0"
                      ItemsSource="{Binding PartNumbers}"
                      SelectedItem="{Binding SelectedPartNo, Mode=TwoWay}"
                      Foreground="Black"/>
        </StackPanel>

        <!-- Probe Cards -->
        <Border Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding Probes}"
                 SelectedItem="{Binding SelectedProbe, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="188" ItemHeight="500"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <local:ProbeSetupProgressBar 
                        Value="{Binding Value}" 
                        Title="{Binding Title}" 
                        ID="{Binding ID}" 
                        Stroke="{Binding Stroke}" 
                                Margin="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Style="{StaticResource DefaultBorderStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="StartBtn"
                        Content="Start Reading"
                        Width="120"
                        Margin="5"
                        Click="StartBtn_Click"/>
                <Button x:Name="StopBtn"
                        Content="Stop Reading"
                        Width="120"
                        Margin="5"
                        Click="StopBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

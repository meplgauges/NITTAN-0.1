<UserControl x:Class="EVMS.ProbeSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EVMS"
             Background="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Design.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
   

    <Grid Margin="6">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Select Part -->
            <RowDefinition Height="*"/>
            <!-- Progress Bars -->
            <RowDefinition Height="Auto"/>
            <!-- Info + Buttons -->
        </Grid.RowDefinitions>

        <!-- Row 0: Select Part inside border -->

        <Border Grid.Row="0" Style="{StaticResource SectionBorder}" Background="{StaticResource PageBackgroundBrush}">
           
            <Grid HorizontalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Select Part:" 
                           VerticalAlignment="Center" 
                           Foreground="Black" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Margin="0,0,12,0" 
                           Grid.Column="0"/>

                <ComboBox
                    Style="{StaticResource ModernComboBoxStyle}"
                    ItemsSource="{Binding PartNumbers}"
                    SelectedItem="{Binding SelectedPartNo, Mode=TwoWay}"
                    Height="30"
                    Width="200"
                    BorderBrush="Aqua"
                    Grid.Column="1"/>

            </Grid>
        </Border>

        <!-- Row 1: Progress Bars -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Background="{StaticResource PageBackgroundBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Probes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="206" ItemHeight="500" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ProbeSetupProgressBar 
                                Value="{Binding Value}" 
                                Title="{Binding Title}" 
                                ID="{Binding ID}" 
                                Stroke="{Binding Stroke}" 
                                Status="{Binding Status}"    
                                Margin="8"/>
                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
           

        </Border>

        <!-- Row 2: Two bordered columns—info and buttons -->
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Info border -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorder}" Margin="0,0,5,0" Padding="10" Background="{StaticResource PageBackgroundBrush}">
                
                <!-- Replace with your info UI here, example TextBlock -->
                <TextBlock Text="Pressure Range should be set beetween 0.200 MM to 1.200 MM" Foreground="Black" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <!-- Buttons border -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Background="{StaticResource PageBackgroundBrush}">

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Start Reading" 
                                Style="{StaticResource ModernButtonStyle2}" 
                                Height="40"
                                Width="130"
                                HorizontalAlignment="Center"
                                Click="StartBtn_Click"/>        

                    <Button Grid.Column="1" Content="Stop Reading" 
                                Style="{StaticResource ModernButtonStyle2}" 
                                Height="40" 
                                Width="130"
                                HorizontalAlignment="Center"
                                Click="StopBtn_Click"/> 
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>

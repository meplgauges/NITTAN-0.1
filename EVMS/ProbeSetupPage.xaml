<UserControl x:Class="EVMS.ProbeSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EVMS"
             Background="#171414">
    <UserControl.Resources>
        <!-- Reusable Border Style -->
        <Style x:Key="DefaultBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#222"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <!-- Top section -->
            <RowDefinition Height="1*" />
            <!-- Bottom section -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <!-- Left column -->
            <ColumnDefinition Width="*" />
            <!-- Right column -->
        </Grid.ColumnDefinitions>

        <!-- ================= Left Top: Probes ================= -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DefaultBorderStyle}">
            <Border.Background>
                <ImageBrush ImageSource="/Resource/1234.jpg"
                            Stretch="UniformToFill"
                            Opacity="0.7"/>
            </Border.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <WrapPanel Orientation="Horizontal" ItemWidth="170" ItemHeight="200">
                    <local:ProgresBarControl x:Name="PB1"  Title="Probe 1"  Value="14" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB2"  Title="Probe 2"  Value="34" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB3"  Title="Probe 3"  Value="56" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB4"  Title="Probe 4"  Value="78" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB5"  Title="Probe 5"  Value="43" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB6"  Title="Probe 6"  Value="65" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB7"  Title="Probe 7"  Value="22" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB8"  Title="Probe 8"  Value="88" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB9"  Title="Probe 9"  Value="15" Margin="5"/>
                    <local:ProgresBarControl x:Name="PB10" Title="Probe 10" Value="50" Margin="5"/>
                </WrapPanel>
            </ScrollViewer>
        </Border>


        <!-- ================= Right Top: Config ================= -->
        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource DefaultBorderStyle}">
            <Border.Background>
                <VisualBrush Stretch="UniformToFill" Opacity="0.7">
                    <VisualBrush.Visual>
                        <Image Source="/Resource/4321.jpg"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>

            <StackPanel VerticalAlignment="Top" Orientation="Vertical">

            </StackPanel>
        </Border>

        <!-- ================= Left Bottom: Extra ================= -->
        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource DefaultBorderStyle}">
            <Border.Background>
                <ImageBrush ImageSource="/Resource/1234.jpg"
                    Stretch="UniformToFill"
                    Opacity="0.7"/>
            </Border.Background>
        </Border>

        <!-- ================= Right Bottom: Extra ================= -->
        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource DefaultBorderStyle}">
            <Border.Background>
                <VisualBrush Stretch="UniformToFill" Opacity="0.7">
                    <VisualBrush.Visual>
                        <Image Source="/Resource/4321.jpg"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>